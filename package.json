    "check:lse": "tsx src/analysis/__lsegroup.ts"
  },
  "dependencies": {
    "cubing": "^0.63.4",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "gan-web-bluetooth": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
