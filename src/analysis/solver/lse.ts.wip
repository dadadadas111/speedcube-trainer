/**
 * The last six edges, solved exactly.
 *
 * ⟨M, U⟩ has only 184,320 positions, which is small enough to walk all of them
 * once and then answer any question about them instantly: how short the best
 * solution is, what it is, and how far a position is from having its edges
 * oriented. No search, no heuristics, no "probably optimal".
 *
 * A position is identified by where six stickers are — the U/D-facing sticker
 * of each of the six edges — plus one top corner to pin down the U layer. Those
 * seven say everything: an edge's U/D sticker gives both its place and which
 * way up it is, and the corner gives the AUF.
 */

import { LSE_UD_FACELETS, PIECES, U_CENTER_FACELET } from '../../cube/cube';
import { isHome, keyOf, moveSet, positionsAfter, stepped, turnsOf } from './tracking';

/** One top corner sticker is enough to tell the four AUFs apart. */
const AUF_MARKER = PIECES.U_CORNERS[0];

/** Six edge stickers, one corner, and the U centre for the slice's own rotation. */
export const LSE_TRACKED = [...LSE_UD_FACELETS, AUF_MARKER, U_CENTER_FACELET];

export const LSE_MOVES = moveSet(turnsOf(['M', 'U']));

export interface LseTables {
  /** Moves from any position back to solved */
  toSolved: Map<number, number>;
  /** Moves from any position to having all six edges oriented and UL/UR placed */
  toEolr: Map<number, number>;
  /** Every position, so a case can be drawn at random */
  all: number[];
  /** The scramble that reaches each position, for setting a case up */
  route: Map<number, string[]>;
}

let tables: LseTables | null = null;

const solvedPositions = () => Uint8Array.from(LSE_TRACKED);

/**
 * Walk the whole group from solved, recording how far every position is and one
 * way of getting there. Roughly a second, once.
 */
function buildTables(): LseTables {
  const toSolved = new Map<number, number>();
  const route = new Map<number, string[]>();
  const all: number[] = [];

  const start = solvedPositions();
  const startKey = keyOf(start);
  toSolved.set(startKey, 0);
  route.set(startKey, []);
  all.push(startKey);

  let frontier: { at: Uint8Array; path: string[] }[] = [{ at: start, path: [] }];
  let depth = 0;
  while (frontier.length) {
    const next: { at: Uint8Array; path: string[] }[] = [];
    depth++;
    for (const node of frontier) {
      for (let m = 0; m < LSE_MOVES.names.length; m++) {
        const at = stepped(node.at, LSE_MOVES.to[m]);
        const key = keyOf(at);
        if (toSolved.has(key)) continue;
        toSolved.set(key, depth);
        // The route stored is the way OUT from solved, so performing it sets
        // the case up; its inverse is one optimal solution.
        route.set(key, [...node.path, LSE_MOVES.names[m]]);
        all.push(key);
        next.push({ at, path: route.get(key)! });
      }
    }
    frontier = next;
  }

  // A second walk, this time out from every position that already counts as
  // EOLR done: all six edges oriented and UL/UR in place.
  const toEolr = new Map<number, number>();
  const goals: Uint8Array[] = [];
  for (const key of all) {
    const at = positionsFromKey(key);
    if (isEolrDone(at)) {
      goals.push(at);
      toEolr.set(key, 0);
    }
  }
  let wave = goals;
  let d = 0;
  while (wave.length) {
    const next: Uint8Array[] = [];
    d++;
    for (const at of wave) {
      for (let m = 0; m < LSE_MOVES.names.length; m++) {
        const to = stepped(at, LSE_MOVES.to[m]);
        const key = keyOf(to);
        if (toEolr.has(key)) continue;
        toEolr.set(key, d);
        next.push(to);
      }
    }
    wave = next;
  }

  return { toSolved, toEolr, all, route };
}

/** Unpack a key back into the eight tracked positions. */
function positionsFromKey(key: number): Uint8Array {
  const out = new Uint8Array(LSE_TRACKED.length);
  let k = key;
  for (let i = out.length - 1; i >= 0; i--) {
    out[i] = k % 54;
    k = Math.floor(k / 54);
  }
  return out;
}

/**
 * Are all six edges oriented, with UL and UR in place?
 *
 * Oriented means each edge's U/D sticker is on the U or D face. In place means
 * the UL and UR stickers are home — and since the U layer may be turned, that
 * is checked against the AUF rather than against the solved cube.
 */
function isEolrDone(at: ArrayLike<number>): boolean {
  for (let i = 0; i < LSE_UD_FACELETS.length; i++) {
    const p = at[i];
    // The U face is facelets 0-8, the D face 27-35
    if (!(p < 9 || (p >= 27 && p < 36))) return false;
  }
  // UL and UR are the last two of LSE_UD_FACELETS by construction; they must be
  // where the current AUF puts them, which is where they started only when the
  // top layer has not been turned relative to them.
  return ulUrPlaced(at);
}

/** The UL/UR edges sit correctly relative to the top corners. */
function ulUrPlaced(at: ArrayLike<number>): boolean {
  // LSE_UD_FACELETS starts with the two side edges (UL, UR); the app's own
  // detector uses the same definition, so agreement here is not a coincidence.
  const ul = at[0];
  const ur = at[1];
  const auf = at[LSE_TRACKED.length - 2];
  const home = LSE_TRACKED;
  const turns = (p: number) => {
    // How many U turns take the solved position to p, or -1 if it left the layer
    const ring = [home[0], home[1]];
    void ring;
    return p;
  };
  void turns;
  // Compare against the solved arrangement rotated by the same amount as the
  // corner marker: the U layer being turned as a whole is an AUF, not an error.
  return sameAuf(ul, home[0], auf) && sameAuf(ur, home[1], auf);
}

/** U-layer positions, in the order a U turn cycles them. */
const U_RING: number[][] = [];
{
  const ringFor = (facelet: number) => {
    const seen: number[] = [facelet];
    let at = Uint8Array.from([facelet]);
    for (let i = 0; i < 3; i++) {
      at = stepped(at, LSE_MOVES.to[LSE_MOVES.names.indexOf('U')]);
      seen.push(at[0]);
    }
    return seen;
  };
  for (const f of [...LSE_UD_FACELETS, AUF_MARKER]) U_RING.push(ringFor(f));
}

/** Is `p` the home position turned by the same number of U turns as the marker? */
function sameAuf(p: number, home: number, marker: number): boolean {
  const markerRing = U_RING[U_RING.length - 1];
  const turnsTaken = markerRing.indexOf(marker);
  if (turnsTaken < 0) return false;
  const ring = U_RING[LSE_TRACKED.indexOf(home)];
  return ring[turnsTaken] === p;
}

export function lseTables(): LseTables {
  if (!tables) tables = buildTables();
  return tables;
}

export interface LseSolution {
  /** Shortest solution, in ⟨M, U⟩ */
  moves: string[];
  length: number;
}

/** The shortest way to finish from here, or null if the position is unreachable. */
export function solveLse(scramble: string[], goal: 'solved' | 'eolr' = 'solved'): LseSolution | null {
  const t = lseTables();
  const at = positionsAfter(LSE_TRACKED, scramble);
  const dist = goal === 'solved' ? t.toSolved : t.toEolr;
  const start = keyOf(at);
  if (!dist.has(start)) return null;

  const moves: string[] = [];
  let cur = at;
  let d = dist.get(start)!;
  while (d > 0) {
    for (let m = 0; m < LSE_MOVES.names.length; m++) {
      const to = stepped(cur, LSE_MOVES.to[m]);
      const nd = dist.get(keyOf(to));
      if (nd === d - 1) {
        moves.push(LSE_MOVES.names[m]);
        cur = to;
        d = nd;
        break;
      }
    }
  }
  return { moves, length: moves.length };
}

/** How far this position is from the goal, without building the solution. */
export function lseDistance(scramble: string[], goal: 'solved' | 'eolr' = 'solved'): number {
  const t = lseTables();
  const dist = goal === 'solved' ? t.toSolved : t.toEolr;
  return dist.get(keyOf(positionsAfter(LSE_TRACKED, scramble))) ?? -1;
}

export const lseSolved = (scramble: string[]) => isHome(positionsAfter(LSE_TRACKED, scramble), LSE_TRACKED);
